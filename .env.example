# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR - ESTUFA MONITOR & CONTROL
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# ==============================================================================

# Porta Serial USB onde o Arduino está conectado
# No Windows: COM3, COM4, COM5, etc.
# No Linux/Raspberry Pi: /dev/ttyUSB0 ou /dev/ttyACM0
SERIAL_PORT=COM3

# Velocidade da comunicação serial (deve ser idêntica ao Serial.begin() do Arduino)
SERIAL_BAUDRATE=9600

# Timeout de leitura em segundos
SERIAL_TIMEOUT=1.0

# Intervalo entre tentativas de reconexão automática se a porta for desconectada (segundos)
SERIAL_RECONNECT_INTERVAL=3.0

# MODO DE SIMULAÇÃO (Útil para testes sem Arduino físico conectado)
# Se SIMULATION_MODE=true, o sistema gera leituras virtuais realistas contínuas.
# Se AUTO_FALLBACK_SIMULATION=true, o sistema tenta a porta serial real e, se não encontrar,
# inicia simulação automaticamente para que a interface web funcione de imediato.
SIMULATION_MODE=false
AUTO_FALLBACK_SIMULATION=true

# URL do Banco de Dados SQLite (caminho relativo ou absoluto)
DATABASE_URL=sqlite:///./estufa.db

# Configurações de Rede do Servidor Web FastAPI
# HOST 0.0.0.0 permite acesso pelo celular e outros PCs na mesma rede Wi-Fi/Ethernet
HOST=0.0.0.0
PORT=8000
DEBUG=false
